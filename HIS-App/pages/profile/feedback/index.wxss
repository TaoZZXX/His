.page { padding: 20rpx; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.subtitle { font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; }
.box {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  border: 1rpx solid #ebeef5;
  border-radius: 10rpx;
  padding: 14rpx;
  background: #fff;
}
.item { padding: 12rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.text { margin-bottom: 6rpx; color: #303133; }
