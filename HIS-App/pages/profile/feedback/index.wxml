<view class="page">
  <view class="card">
    <view class="title">意见反馈</view>
    <textarea
      class="box"
      placeholder="请输入你遇到的问题或建议..."
      value="{{content}}"
      bindinput="onInput"
    ></textarea>
    <button class="primary-btn" bindtap="onSubmit">提交反馈</button>
  </view>

  <view class="card" wx:if="{{history.length}}">
    <view class="subtitle">最近反馈</view>
    <block wx:for="{{history}}" wx:key="createTime">
      <view class="item">
        <view class="text">{{item.content}}</view>
        <view class="muted">{{item.createTime}}</view>
      </view>
    </block>
  </view>
</view>
