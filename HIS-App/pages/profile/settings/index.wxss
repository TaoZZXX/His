.page { padding: 20rpx; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.label { margin-top: 16rpx; margin-bottom: 8rpx; color: #606266; }
.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #ebeef5;
  border-radius: 10rpx;
  padding: 12rpx;
  background: #fff;
}
.textarea { min-height: 160rpx; }
.ghost-btn {
  margin-top: 16rpx;
  color: #8b5cf6;
  border: 1rpx solid #d8ccff;
  background: #f7f3ff;
}
