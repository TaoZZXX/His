<view class="page">
  <view class="card auth-tip">
    <view class="muted">推荐先获取微信头像昵称，再去挂号页填写实名信息</view>
    <button class="primary-btn" bindtap="getWxProfile">获取微信资料</button>
  </view>

  <view class="hero">
    <image wx:if="{{wxProfile.avatarUrl}}" class="avatar-img" src="{{wxProfile.avatarUrl}}"></image>
    <view wx:else class="avatar"></view>
    <view class="name">Hi，{{wxProfile.nickName || '微信用户'}}</view>
    <view class="field">就诊人:{{patientProfile.name || '未填写'}}</view>
    <view class="field">身份证号:{{patientProfile.idCard || '未填写'}}</view>
  </view>

  <view class="card menu">
    <block wx:for="{{menus}}" wx:key="key">
      <view class="menu-item" data-key="{{item.key}}" bindtap="onMenuTap">
        <text>{{item.name}}</text>
        <text class="muted">></text>
      </view>
    </block>
  </view>
</view>
