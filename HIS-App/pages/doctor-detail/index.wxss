.page { padding: 20rpx; }

.doctor {
  padding: 16rpx;
  display: flex;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #ddd6f3;
}

.info { margin-left: 16rpx; flex: 1; }
.line { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.name { font-size: 44rpx; font-weight: 700; }
.badge { background: #8b5cf6; color: #fff; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 24rpx; }

.schedule { margin-top: 16rpx; padding: 0 14rpx; }
.item {
  display: grid;
  grid-template-columns: 50rpx 1fr auto auto;
  gap: 14rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee8ff;
}

.item:last-child { border-bottom: none; }
.text { font-size: 32rpx; }

.form-card { margin-top: 16rpx; padding: 16rpx; }
.form-title { font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; }
.input {
  height: 76rpx;
  border: 1rpx solid #ddd6f3;
  border-radius: 10rpx;
  padding: 0 14rpx;
  margin-bottom: 10rpx;
}
.gender-row { display: flex; gap: 24rpx; margin: 6rpx 0 12rpx; }
.gender-item { display: flex; align-items: center; gap: 8rpx; }

.primary-btn { margin-top: 18rpx; }
