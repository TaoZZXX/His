.page { padding: 20rpx; }

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.title { font-size: 44rpx; color: #4b445f; }
.total { font-size: 40rpx; color: #4b445f; }

.card { padding: 0 18rpx; margin-bottom: 18rpx; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee8ff;
}

.row:last-child { border-bottom: none; }
.name { font-size: 40rpx; margin-bottom: 6rpx; }
.type { font-size: 34rpx; color: #433a56; }

.invoice {
  margin: 14rpx 0 8rpx;
  font-size: 26rpx;
}
