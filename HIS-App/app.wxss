page {
  background: #f7f5ff;
  color: #2f2a3a;
  font-size: 28rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #ddd6f3;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin: 20rpx 0;
}

.primary-btn {
  background: #8b5cf6;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.muted {
  color: #8c86a0;
}
