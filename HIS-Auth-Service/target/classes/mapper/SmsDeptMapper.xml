<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.his.mapper.SmsDeptMapper">
    <select id="selectDeptById" resultType="com.his.domain.SmsDept">
        SELECT id, code, cat_id AS catId, name, type, status
        FROM sms_dept
        WHERE id = #{id}
    </select>
</mapper>
