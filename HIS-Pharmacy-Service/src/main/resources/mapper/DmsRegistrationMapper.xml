<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.his.mapper.DmsRegistrationMapper">
    <select id="selectById" resultType="com.his.domain.DmsRegistration">
        select id, bind_status as bindStatus from dms_registration where id = #{id}
    </select>
</mapper>
